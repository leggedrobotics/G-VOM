<launch>
    <node pkg="gsvom" type="gsvom_ros.py" name="gsvom_ros" output="screen">
    	<remap from="~cloud" to="/gt_box/livox/lidar" />
    	<remap from="~odom" to="/gt_box/zed2i/zed_node/odom" />
    	<remap from="~segmented_image1" to="/gt_box/hdr_front/segmentation/segmented_image" />
    	<remap from="~camera_info1" to="/gt_box/hdr_front/segmentation/camera_info" />
    	<remap from="~segmented_image2" to="/gt_box/hdr_right/segmentation/segmented_image" />
    	<remap from="~camera_info2" to="/gt_box/hdr_right/segmentation/camera_info" />
    	<remap from="~segmented_image3" to="/gt_box/hdr_left/segmentation/segmented_image" />
    	<remap from="~camera_info3" to="/gt_box/hdr_left/segmentation/camera_info" />
    	
    	<param name="~odom_frame" value="zed2i_odom"/>
    	
        <param name="~association_model_type" value="v6"/>
        <param name="~association_model_weights_path" value="$(find gsvom)/config/model_weights/model_v6_trained_w_mlp.pt"/>
        <param name="~geometric_feature_type" value="mlp"/>
        <param name="~feature_extractor_weights_path" value="$(find gsvom)/config/model_weights/v6_mlp_features_trained.pt"/>
        <param name="~visualization_colors_file" value="$(find gsvom)/config/label_colors.txt"/>
    </node>
</launch>
